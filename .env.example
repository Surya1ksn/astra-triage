# Copy this file to .env and fill in real values if you want to exercise
# the live-LLM path. Everything works offline without these set.

# Base URL of the "approved internal proxy" for LLM calls.
# In this practice repo, leaving it unset makes llm_client.py fall back
# to a deterministic local stub — good enough for Stage 2-4 offline work.
ASTRA_LLM_BASE_URL=

# API key read from environment ONLY. Never hardcode this in source.
ASTRA_LLM_API_KEY=

# Model name to request from the proxy.
ASTRA_LLM_MODEL=claude-sonnet-4-5

# Minimum classifier confidence required to auto-handle a ticket (0-1).
ASTRA_CLASSIFICATION_THRESHOLD=0.55

# Minimum retrieval similarity score required to treat a KB hit as relevant (0-1).
ASTRA_RETRIEVAL_THRESHOLD=0.30
